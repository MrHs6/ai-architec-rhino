<Window x:Class="Studio.StudioWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:studio="clr-namespace:Studio" Title="AI Archi-Tec Studio · Workspace" Icon="Assets/logo.png" Width="1010" Height="760" UseLayoutRounding="True" MinWidth="410" MinHeight="570" Background="#101115" Foreground="#F3F1FC" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" PreviewKeyDown="WorkspaceKeyDown">
<Window.Resources><ResourceDictionary Source="StudioTheme.xaml"/></Window.Resources>

<DockPanel Background="#101115">
  <Border DockPanel.Dock="Top" Background="#101115" BorderBrush="#292A31" BorderThickness="0,0,0,1" Padding="10,5">
    <WrapPanel x:Name="TopActions" VerticalAlignment="Center">
      <Button x:Name="PlatformButton" Click="PlatformClick" Padding="4,3,12,3" ToolTip="Open your AI Archi-Tec web workspace" AutomationProperties.Name="Open AI Archi-Tec platform">
        <StackPanel Orientation="Horizontal"><Image Source="Assets/logo.png" Width="27" Height="27"/><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">AI Archi-Tec</TextBlock></StackPanel>
      </Button>
      <Button Click="ToggleRail" AutomationProperties.Name="Applications"><StackPanel Orientation="Horizontal"><studio:StudioGlyph Kind="apps"/><TextBlock Text="Applications" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button><Button Click="WorkspaceMenu" AutomationProperties.Name="Orchestration"><StackPanel Orientation="Horizontal"><studio:StudioGlyph Kind="flow"/><TextBlock Text="Orchestration" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
      <Button Click="ProviderMenu" ToolTip="API settings" AutomationProperties.Name="API settings"><studio:StudioGlyph Kind="settings"/></Button><Button x:Name="AccountButton" Click="StudioMenu" ToolTip="Studio account" AutomationProperties.Name="Studio account"><studio:StudioGlyph Kind="account"/></Button>
    </WrapPanel>
  </Border>
  <Grid><Grid x:Name="WorkspaceRoot"><Grid.ColumnDefinitions><ColumnDefinition x:Name="RailWidth" Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border x:Name="Rail" Visibility="Collapsed" Background="#101116" BorderThickness="0,0,1,0" BorderBrush="#302C38"><DockPanel Margin="12,20,12,14">
<StackPanel DockPanel.Dock="Top"><TextBlock FontWeight="SemiBold" FontSize="16" Margin="8,0">Design tools</TextBlock><TextBlock Margin="10,24,0,8" Foreground="{StaticResource Muted}">Select an application</TextBlock></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Button Click="OpenConnectorFolder" Background="Transparent">Connector files ↗</Button></StackPanel>
<ListBox x:Name="Host" Background="Transparent" BorderThickness="0" SelectionChanged="TargetChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel></Border>

<Grid Grid.Column="1" Margin="16,14,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border CornerRadius="12" BorderBrush="#33303B" BorderThickness="1"><Border.Background><ImageBrush ImageSource="Assets/hero-wave.jpg" Stretch="UniformToFill" AlignmentY="Center"/></Border.Background>
<Border CornerRadius="11" Padding="16,12"><Border.Background><LinearGradientBrush StartPoint="0,0.6" EndPoint="1,0.4"><GradientStop Color="#FD17171F"/><GradientStop Offset="0.46" Color="#EF191621"/><GradientStop Offset="1" Color="#5E10101B"/></LinearGradientBrush></Border.Background>
<DockPanel><StackPanel DockPanel.Dock="Right" VerticalAlignment="Top"><ComboBox x:Name="Edition" SelectionChanged="VersionChanged" ToolTip="Application version"/><ToggleButton x:Name="Pin" HorizontalAlignment="Right" Style="{StaticResource PinStyle}" ToolTip="Keep window on top" AutomationProperties.Name="Keep window on top" Click="PinClick">&#xE718;</ToggleButton></StackPanel>
<StackPanel><TextBlock Foreground="#CBB9F4" FontSize="11" FontWeight="SemiBold">Model workspace</TextBlock><TextBlock x:Name="HostTitle" FontSize="31" FontWeight="SemiBold" Margin="0,1,0,1"/><TextBlock x:Name="HostDescription" TextWrapping="Wrap" Foreground="#D1CCDA"/><WrapPanel Margin="-5,7,0,-1"><Button x:Name="ConnectButton" Click="ToggleConnections" Background="#3B314C">Connect an app  ⌄</Button><Button Click="Inspect">Inspect</Button><Button x:Name="ViewButton" Click="Viewport">Capture view</Button></WrapPanel></StackPanel></DockPanel></Border></Border>


<DockPanel Grid.Row="2">
<Border DockPanel.Dock="Top" x:Name="ConnectPanel" Margin="0,8,0,0" Background="#1A191F" CornerRadius="11" Padding="12,9"><StackPanel>
<TextBlock FontWeight="SemiBold" Text="Application connection"/><WrapPanel x:Name="HostTiles" Margin="0,5,0,3"/>
<WrapPanel Margin="0,2,0,5"><TextBlock x:Name="BridgeStep" FontSize="11" Margin="0,0,14,0"/><TextBlock x:Name="AppStep" FontSize="11" Margin="0,0,14,0"/><TextBlock x:Name="HandshakeStep" FontSize="11"/></WrapPanel>
<TextBlock x:Name="SetupHint" TextWrapping="Wrap" Foreground="#C5BED0" FontSize="12"/>
<WrapPanel Margin="-2,3,0,0"><Button x:Name="InstallBridge" Click="InstallBridgeClick">Install bridge</Button><Button x:Name="LaunchHost" Click="LaunchHostClick">Open app</Button><Button x:Name="ProbeHost" Click="ProbeHostClick" Background="#30273E">Check connection</Button></WrapPanel>
</StackPanel></Border>
<ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Margin="0,10"><StackPanel x:Name="Messages" MaxWidth="860"/></ScrollViewer></DockPanel>
<Border Grid.Row="3" CornerRadius="13" MaxWidth="860" BorderThickness="1" BorderBrush="#3A3947" Background="#191A21" Padding="10"><StackPanel><DockPanel x:Name="AttachmentBar" Visibility="Collapsed"><Button DockPanel.Dock="Right" Click="RemoveAttachment">Remove</Button><Image x:Name="Thumb" Width="50" Height="42" DockPanel.Dock="Left" Stretch="UniformToFill"/><TextBlock x:Name="FileLabel" VerticalAlignment="Center" Margin="8,0"/></DockPanel>
<Grid><TextBlock Text="Describe a design or ask a question…" Foreground="#93899F" Margin="8,7" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Prompt}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox AllowDrop="True" PreviewDragOver="ImageDrag" Drop="ImageDrop" x:Name="Prompt" ToolTip="Write a message · Enter to send · Shift+Enter for a new line" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="47" MaxHeight="130" VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnKey"/></Grid>
<DockPanel><Button x:Name="StopButton" Visibility="Collapsed" DockPanel.Dock="Right" Click="StopTurn">Stop</Button><Button x:Name="SendButton" DockPanel.Dock="Right" Background="#BFA9F2" Foreground="#171126" FontWeight="SemiBold" Click="Send" ToolTip="Send message" AutomationProperties.Name="Send message"><studio:StudioGlyph Kind="send"/></Button><WrapPanel><ListBox x:Name="Mode" SelectedIndex="1" AutomationProperties.Name="Conversation mode" Foreground="#E6E1EF" Background="#111217" BorderThickness="0" Padding="2" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem ToolTip="Propose and apply design operations" Padding="6,4"><StackPanel Orientation="Horizontal"><studio:StudioGlyph Kind="build"/><TextBlock Text="Build" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem ToolTip="Discuss the design without running tools" Padding="6,4"><StackPanel Orientation="Horizontal"><studio:StudioGlyph Kind="chat"/><TextBlock Text="Chat" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem></ListBox><Button Click="ComposerMenu" ToolTip="Chat tools" AutomationProperties.Name="Chat tools" Padding="6"><studio:StudioGlyph Kind="tools"/></Button><Button Click="Attach" ToolTip="Attach an image or text reference" AutomationProperties.Name="Attach reference" Padding="6"><studio:StudioGlyph Kind="attach"/></Button><Button x:Name="Mic" Click="VoiceClick" ToolTip="Record or finish dictation" AutomationProperties.Name="Record or finish dictation" Padding="6"><studio:StudioGlyph Kind="mic"/></Button></WrapPanel></DockPanel>
<TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource Muted}" Margin="5,5,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid></Grid>
<DockPanel x:Name="PlatformPane" Visibility="Collapsed" Background="#101115">
  <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#303039" Padding="10,4"><WrapPanel>
    <Button x:Name="DesktopChatButton" Click="ReturnToChat">← Desktop chat</Button><Button x:Name="BrowserBack" Click="BackInPlatform" IsEnabled="False">Back</Button><Button Click="ReloadPlatform">Reload</Button><Button Click="ExternalPlatform">Open in browser ↗</Button>
  </WrapPanel></Border>
  <TextBlock x:Name="WebStatus" DockPanel.Dock="Bottom" Margin="14,6" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
  <Grid x:Name="WebHost"/>
</DockPanel><Expander x:Name="Settings" Style="{StaticResource SettingsSheet}" Expanded="SettingsOpened" Collapsed="SettingsClosed" Panel.ZIndex="10" KeyboardNavigation.TabNavigation="Cycle"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,18">
<DockPanel><Button DockPanel.Dock="Right" Click="CloseSettings" ToolTip="Close settings" AutomationProperties.Name="Close settings">✕</Button><TextBlock FontSize="21" FontWeight="SemiBold" Text="API settings"/></DockPanel>
<TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,18" Text="Choose the model that powers this conversation."/>
<TextBlock Margin="0,0,0,14" Foreground="#ACDECF">OpenRouter · Key verified</TextBlock>
<TextBlock Margin="0,0,0,5">Chat model</TextBlock><ComboBox x:Name="ChatModel" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="Chat model ID"/>
<TextBlock Margin="0,16,0,5">Build model · tool calling</TextBlock><ComboBox x:Name="BuildModel" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="Build model ID"/>
<TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14">Select a model or type its exact OpenRouter ID. Newest models appear first.</TextBlock>
<Button Click="RefreshModelsClick" HorizontalAlignment="Left">Refresh model list</Button>
<TextBlock x:Name="ModelTestStatus" TextWrapping="Wrap" Margin="0,8" Foreground="#CABBDF" AutomationProperties.LiveSetting="Polite"/></StackPanel></ScrollViewer></Expander></Grid></DockPanel></Window>