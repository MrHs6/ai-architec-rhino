<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="Muted" Color="#ABA6BF"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1EDF8"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#ECE8F4"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#40384F"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F2EEFF"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Foreground="#F1EDF8" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#272730" CornerRadius="6"><DockPanel Margin="10,6"><TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="⌄"/><ContentPresenter x:Name="ValuePresenter" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton><TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="2,2,30,2" Padding="8,5" Background="#272730" BorderThickness="0" Foreground="#F2EEFF"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="#292734" CornerRadius="5" Padding="3"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DDD8EF"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="row" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="row" Property="Background" Value="#514362"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#1D1C26"/><Setter Property="Foreground" Value="#F1EEF6"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#464151"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E6E1EF"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="b" Margin="0,1" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#23212C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#393048"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

<Style TargetType="PasswordBox">
  <Setter Property="Background" Value="#1D1E26"/><Setter Property="Foreground" Value="#F2EFFA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#44434E"/><Setter Property="Padding" Value="8,6"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="field" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="field" Property="BorderBrush" Value="#B49BDD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="SettingsPanel" TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="0,8,0,0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Border Background="#18191E" BorderBrush="#313139" BorderThickness="1" Padding="11,8" CornerRadius="9"><DockPanel><TextBlock DockPanel.Dock="Top" Margin="5,0,0,4" FontWeight="SemiBold" Text="{TemplateBinding Header}"/><ContentPresenter/></DockPanel></Border></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsExpanded" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
</Style>
<Style x:Key="PopupMenu" TargetType="ContextMenu"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border CornerRadius="8" BorderThickness="1" BorderBrush="#44404C" Background="#202026" Padding="4"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="PopupOption" TargetType="MenuItem"><Setter Property="Foreground" Value="#EDEBF3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="option" CornerRadius="4" Padding="12,6" Background="Transparent"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="option" Property="Background" Value="#393046"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<ControlTemplate x:Key="ScrollPage" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Template="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2" CornerRadius="3" Background="#585460"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Template="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Template="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2" Background="#585460" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Template="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
<Style x:Key="PinStyle" TargetType="ToggleButton"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#DFDBEE"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="pin" Background="#B01B1926" Padding="7" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pin" Property="Background" Value="#514360"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="pin" Property="Background" Value="#735597"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="SettingsSheet" TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Grid Background="#AA09090D"><Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="425" MaxHeight="550" Background="#1B1A22" BorderThickness="1" BorderBrush="#484052" CornerRadius="16" Margin="0,6"><ContentPresenter/></Border></Grid></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsExpanded" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
