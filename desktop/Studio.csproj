<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><AssemblyName>ArchiTecStudio</AssemblyName>
    <ApplicationIcon>Assets/Studio.ico</ApplicationIcon><Version>0.6.5</Version><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><Resource Include="../rhino-plugin/src/ArchiTec.Rhino/Assets/logo.png" Link="Assets/logo.png"/></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/hero-wave.jpg;Assets/studio-entry.jpg"/>
    <EmbeddedResource Include="Assets/site.json"/>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58"/>
    <None Update="Assets/studio-entry.jpg" Link="Brand/studio-entry.jpg" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../rhino-plugin/src/ArchiTec.Rhino/Assets/logo.png" Link="Brand/logo.png" CopyToOutputDirectory="PreserveNewest"/>
    <None Update="Connectors/StudioScene.py" TargetPath="Connectors/StudioScene.FCMacro" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Connectors/**/*" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
