<Window x:Class="Studio.WelcomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Archi-Tec Studio" Icon="Assets/logo.png" Width="452" Height="556" MinWidth="360" MinHeight="470" WindowStartupLocation="CenterScreen" Background="#101115" Foreground="#F4F1F8" FontFamily="Segoe UI">
<Window.Resources><ResourceDictionary Source="StudioTheme.xaml"/></Window.Resources>
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border CornerRadius="16"><Border.Background><ImageBrush ImageSource="Assets/studio-entry.jpg" Stretch="UniformToFill"/></Border.Background><Border CornerRadius="16" Padding="18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00121218"/><GradientStop Offset="1" Color="#DA121019"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Bottom"><Image Source="Assets/logo.png" HorizontalAlignment="Left" Width="39" Height="39"/><TextBlock Margin="0,8,0,0" FontWeight="SemiBold" FontSize="26">AI Archi-Tec Studio</TextBlock></StackPanel></Border></Border>
<StackPanel Grid.Row="1" Margin="9,23,9,0"><TextBlock FontWeight="SemiBold" FontSize="25">Welcome back</TextBlock><TextBlock Foreground="#B6B0C4" Margin="0,4,0,15" TextWrapping="Wrap">Connect your AI Archi-Tec workspace to your design tools.</TextBlock><Button x:Name="LoginButton" Click="Login" Background="#CEB6F6" Foreground="#1D1428" Padding="12,10" FontWeight="SemiBold">Sign in with browser  ↗</Button>
<TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Foreground="#C9BBD9" Margin="2,8,2,2" MinHeight="22"/></StackPanel>
<Button Grid.Row="2" HorizontalAlignment="Center" Click="RequestAccess" Padding="8,5">Request workspace access ↗</Button></Grid></Window>
