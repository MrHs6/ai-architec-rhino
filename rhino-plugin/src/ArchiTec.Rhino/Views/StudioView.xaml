<UserControl x:Class="ArchiTec.RhinoPlugin.Views.StudioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B0D18" Foreground="#F2F1FA" FontFamily="Segoe UI" FontSize="12" MinWidth="330">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9399B5"/>
  <SolidColorBrush x:Key="Card" Color="#141729"/>
  <LinearGradientBrush x:Key="Primary" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#934AF5" Offset="0"/><GradientStop Color="#4D6CF1" Offset="1"/></LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E8E9F6"/><Setter Property="Background" Value="#1A1E33"/><Setter Property="BorderBrush" Value="#30344C"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#A38CF4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,5"/><Setter Property="FontSize" Value="17"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101424"/><Setter Property="Foreground" Value="#E9EAF8"/><Setter Property="CaretBrush" Value="#C7B1FF"/><Setter Property="BorderBrush" Value="#353A56"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="SelectionBrush" Value="#6E50BE"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#101424"/><Setter Property="Foreground" Value="#E9EAF8"/><Setter Property="CaretBrush" Value="#C7B1FF"/><Setter Property="BorderBrush" Value="#353A56"/><Setter Property="Padding" Value="11,9"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECEBF5"/><Setter Property="Background" Value="#1C2035"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#353A56"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#1B2036"/><Setter Property="Foreground" Value="#ECEBF5"/><Setter Property="Padding" Value="10,7"/></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#1A1E33" BorderBrush="#343952" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" Foreground="#ADB1CB" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,7,28,7" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1A1E33" BorderBrush="#4B426C" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="330"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B7BCD3"/><Setter Property="Margin" Value="0,8"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101222" BorderBrush="#22253B" BorderThickness="0,0,1,0">
   <DockPanel Margin="7,13">
    <StackPanel DockPanel.Dock="Top">
     <Ellipse Width="46" Height="46" Margin="0,0,0,18"><Ellipse.Fill><ImageBrush x:Name="RailLogoBrush" Viewbox="0.082,0.092,0.834,0.828" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
     <Button x:Name="GenerateNav" Height="55" Margin="0,3" Padding="3" Click="GenerateMode" ToolTip="Generate new geometry"><StackPanel><TextBlock Text="◇" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Generate" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="AnalyzeNav" Height="55" Margin="0,3" Padding="3" Click="AnalyzeMode" ToolTip="Analyze model; read-only"><StackPanel><TextBlock Text="⌁" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Analyze" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="AssistNav" Height="55" Margin="0,3" Padding="3" Click="AssistMode" ToolTip="Edit selected or recent targets"><StackPanel><TextBlock Text="↗" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Assist" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Button Style="{StaticResource Nav}" Content="&#xE192;" ToolTip="API profiles" Click="SettingsClick"/>
     <Button Style="{StaticResource Nav}" Content="&#xE774;" ToolTip="MCP connection" Click="McpClick"/>
     <Button Style="{StaticResource Nav}" Content="&#xE713;" ToolTip="Studio preferences" Click="GeneralClick"/>
     <Button Style="{StaticResource Nav}" Content="&#xE946;" ToolTip="About the creator" Click="AboutClick"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="16,16,16,10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Ellipse Width="52" Height="52" Margin="0,0,11,0"><Ellipse.Fill><ImageBrush x:Name="BrandLogoBrush" Viewbox="0.082,0.092,0.834,0.828" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="AI "/><Run Text="Archi-Tec" Foreground="#B69BF8"/></TextBlock><TextBlock Text="ARCHITECTURE, IN YOUR WORKFLOW" FontSize="7.5" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    <Button Grid.Column="2" Style="{StaticResource Quiet}" Content="↔" FontSize="21" ToolTip="Connection overview" Click="DashboardClick"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,14,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Padding="0,4" Click="DashboardClick"><TextBlock x:Name="ConnectionLabel" Foreground="#D0B378" Text="●  Offline examples" FontSize="10"/></Button><Button Grid.Column="1" x:Name="McpChip" Click="McpClick" Padding="8,4" FontSize="10" Content="MCP  ↗"/></Grid><ComboBox x:Name="ModelSelector" Visibility="Collapsed" Margin="0,7,0,0" SelectionChanged="ModelChanged"/><TextBlock x:Name="ContextLabel" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#141729" CornerRadius="10" Padding="12" Margin="0,0,0,10"><StackPanel>
     <TextBlock x:Name="WorkspaceTitle" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceDescription" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,10"/>
     <StackPanel x:Name="GenerateOptions"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Facade for concept buildings" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="FacadeSelector" SelectedIndex="0" SelectionChanged="OptionChanged"><ComboBoxItem Content="Glazed"/><ComboBoxItem Content="Solid"/><ComboBoxItem Content="None"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Output layer prefix" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="OutputLayer" Text="AI_Building" TextChanged="OptionTextChanged"/></StackPanel></Grid></StackPanel>
     <StackPanel x:Name="AnalyzeOptions" Visibility="Collapsed"><ComboBox x:Name="AnalysisFocus" SelectedIndex="0" SelectionChanged="OptionChanged"><ComboBoxItem Content="Dimensions and bounds"/><ComboBoxItem Content="Geometry health"/><ComboBoxItem Content="Layer organization"/></ComboBox><ComboBox x:Name="AnalysisScope" SelectedIndex="0" Margin="0,7,0,0" SelectionChanged="OptionChanged"><ComboBoxItem Content="Selected objects"/><ComboBoxItem Content="Recent generated output"/></ComboBox><Button Content="Run local model audit" Click="AuditClick" Margin="0,8,0,0" ToolTip="Read actual Rhino geometry without an API key"/></StackPanel>
     <StackPanel x:Name="AssistOptions" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="AssistOperation" SelectedIndex="0" SelectionChanged="OptionChanged" Margin="0,0,6,0"><ComboBoxItem Content="Move"/><ComboBoxItem Content="Scale"/><ComboBoxItem Content="Extrude curve"/></ComboBox><ComboBox Grid.Column="1" x:Name="AssistScope" SelectedIndex="0" SelectionChanged="OptionChanged"><ComboBoxItem Content="Selected objects"/><ComboBoxItem Content="Recent output"/></ComboBox></Grid><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock x:Name="AmountLabel" Text="Distance (document units)" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="AssistAmount" Text="2" TextChanged="OptionTextChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Axis (Move)" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="AssistAxis" SelectedIndex="0" SelectionChanged="OptionChanged"><ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/></ComboBox></StackPanel></Grid><Button x:Name="QuickAssistButton" Content="Preview selected operation" Click="QuickAssistClick" Margin="0,8,0,0"/></StackPanel>
    <Border x:Name="RecentResultBar" Visibility="Collapsed" Background="#1C2234" CornerRadius="7" Padding="8" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="RecentResultLabel" TextWrapping="Wrap" FontSize="10" Foreground="#9DD4C0"/><WrapPanel Margin="0,5,0,0"><Button x:Name="RefineResultButton" Content="Refine result →" Click="RefineResultClick" Padding="7,4" FontSize="10"/><Button x:Name="SelectResultButton" Content="Select" Click="SelectResultClick" Padding="7,4" FontSize="10" Margin="5,0"/><Button x:Name="ExplainResultButton" Content="Explain" Click="ExplainResultClick" Padding="7,4" FontSize="10"/></WrapPanel></StackPanel></Border></StackPanel></Border>
    <Grid Grid.Row="1"><ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel x:Name="Conversation"><StackPanel x:Name="Welcome" Margin="0,12,0,15"><TextBlock x:Name="HeroTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="HeroDescription" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="19" Margin="0,10,0,16"/><Button x:Name="ExampleButton" HorizontalContentAlignment="Left" Click="WorkspaceExample" Padding="12"/></StackPanel></StackPanel></ScrollViewer>
     <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#F50B0D18" CornerRadius="10" VerticalAlignment="Bottom" Padding="12"><StackPanel><Grid><TextBlock Text="Working on your request…" Foreground="#C4AFFA"/><Button Content="Cancel" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Click="CancelClick" Padding="5"/></Grid><ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Foreground="#9568F5"/></StackPanel></Border>
    </Grid>
   </Grid>
   <Border x:Name="PreviewCard" Grid.Row="3" Visibility="Collapsed" Background="#171A30" BorderBrush="#51406F" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,10,0,10"><StackPanel><Grid><TextBlock Text="VALIDATED PREVIEW" FontSize="9" Foreground="#BBA0F3"/><TextBlock x:Name="ActionCount" HorizontalAlignment="Right" FontSize="9" Foreground="{StaticResource Muted}"/></Grid><ScrollViewer MaxHeight="70"><TextBlock x:Name="PlanSummary" TextWrapping="Wrap" Margin="0,7"/></ScrollViewer><TextBlock x:Name="PlanUnits" FontSize="9" Foreground="{StaticResource Muted}"/><Expander Header="Operations" Foreground="#A4ACC9" FontSize="10" Margin="0,6"><ScrollViewer MaxHeight="70"><TextBlock x:Name="PlanDetails" TextWrapping="Wrap"/></ScrollViewer></Expander><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Apply to Rhino →" Background="{StaticResource Primary}" BorderThickness="0" Click="ApplyClick"/><Button Grid.Column="1" Content="Cancel" Style="{StaticResource Quiet}" Click="CancelClick"/></Grid></StackPanel></Border>
   <Border Grid.Row="4" Background="#131628" BorderBrush="#3F385B" BorderThickness="1" CornerRadius="11" Padding="11"><StackPanel><Grid><TextBox x:Name="PromptInput" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="110" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" TextChanged="PromptChanged" PreviewKeyDown="PromptKey"/><TextBlock x:Name="PromptPlaceholder" Foreground="#737D9F" IsHitTestVisible="False" TextWrapping="Wrap"/></Grid><TextBlock x:Name="AttachmentLabel" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#B4A2E2" Margin="0,5"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="AttachButton" Style="{StaticResource Quiet}" Click="AttachClick" ToolTip="Attach or remove a reference"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE723;" FontSize="16"/></Button><TextBlock x:Name="ModeLabel" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="5,0"/><Button Grid.Column="2" x:Name="SendButton" Background="{StaticResource Primary}" BorderThickness="0" Click="SendClick"/></Grid></StackPanel></Border>
   <Grid Grid.Row="5" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><Button x:Name="ImportButton" Grid.Column="1" Style="{StaticResource Quiet}" Padding="0" FontSize="9" Content="Import plan" Click="ImportClick"/></Grid>
  </Grid>
  <Border x:Name="PageOverlay" Grid.Column="1" Visibility="Collapsed" Background="#0B0D18" Padding="18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><Button Content="←  Back to workspace" HorizontalAlignment="Left" Style="{StaticResource Quiet}" Click="CloseSettings" Padding="0,5"/><TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,5"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"><StackPanel>
     <StackPanel x:Name="ApiSettings" Visibility="Collapsed"><TextBlock Text="One profile for each service." FontSize="16"/><TextBlock Text="Keys, endpoints and selected models stay separate. Saving a profile does not send a modeling request." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,17"/><TextBlock Text="AI service" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="SourceSelector" SelectionChanged="SourceChanged"/><TextBlock x:Name="ProviderProtocol" Foreground="#BBA4EF" FontSize="10" Margin="0,8"/><TextBlock Text="API base URL" Foreground="{StaticResource Muted}" Margin="0,8,0,5"/><TextBox x:Name="ApiUrl" TextChanged="ProfileEdited"/><TextBlock Text="Personal API key" Foreground="{StaticResource Muted}" Margin="0,14,0,5"/><PasswordBox x:Name="ApiKey" PasswordChanged="ProfileEdited"/><CheckBox x:Name="RememberKey" Content="Remember securely after restarting Rhino" Checked="ProfileEdited" Unchecked="ProfileEdited"/><TextBlock x:Name="ProfileSaveStatus" Foreground="#9DD4C0" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,8"/><TextBlock x:Name="ProviderNotes" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="0,5,0,14"/><Button x:Name="ConnectButton" Content="Connect and discover models →" Background="{StaticResource Primary}" BorderThickness="0" Click="ConnectClick"/><ComboBox x:Name="ProfileModelSelector" Margin="0,12,0,0" SelectionChanged="ProfileModelChanged" ToolTip="Model for this provider profile"/><Button x:Name="SaveProfileButton" Content="Save this profile" Click="SaveProfileClick" Margin="0,10,0,0"/><TextBlock x:Name="ApiStatus" Foreground="#C1ADF0" TextWrapping="Wrap" Margin="0,12"/><Button x:Name="ApiCancelButton" Content="Cancel connection request" Click="CancelClick" Visibility="Collapsed"/><Button x:Name="TestNetworkButton" Content="Test network · no API key sent" Click="TestNetworkClick" Margin="0,8"/><TextBlock x:Name="NetworkStatus" Foreground="#D0B378" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,12"/><Button Content="Disconnect API · use offline tools" Background="Transparent" Click="OfflineClick"/></StackPanel>
     <StackPanel x:Name="McpSettings" Visibility="Collapsed"><TextBlock Text="Desktop clients ↔ this Rhino session" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="Start explicitly, then copy the current client setup. This connection is independent of API profiles." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,17"/><TextBlock Text="Localhost port (1024–65535)" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="McpPort" Text="5188"/><Button x:Name="McpStartButton" Content="Start localhost MCP →" Background="{StaticResource Primary}" BorderThickness="0" Click="McpStartClick" Margin="0,12,0,0"/><TextBlock x:Name="McpStatus" Foreground="#BCA4F1" Text="Stopped" Margin="0,14" TextWrapping="Wrap"/><TextBox x:Name="McpUrl" IsReadOnly="True" Text="http://127.0.0.1:5188/mcp"/><TextBlock Text="Session access token" Foreground="{StaticResource Muted}" Margin="0,14,0,5"/><PasswordBox x:Name="McpToken" IsEnabled="False"/><Button Content="Copy desktop client setup" Click="CopyMcpClick" Margin="0,14,0,8"/><Button Content="Open ChatGPT website ↗" Click="OpenChatClick" Background="Transparent"/><TextBlock Text="Cloud chat cannot reach Windows localhost directly. Use a compatible local client or connector. Opening ChatGPT does not configure MCP or send a prompt. Proposals require Apply inside Rhino." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" LineHeight="18" Margin="0,17,0,0"/></StackPanel>
     <StackPanel x:Name="GeneralSettings" Visibility="Collapsed"><TextBlock Text="Studio preferences" FontSize="16"/><TextBlock Text="Presentation and workflow defaults. API credentials and MCP controls have their own pages." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18"/><TextBlock Text="Workspace on next launch" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="DefaultWorkspace" SelectedIndex="0"><ComboBoxItem Content="Generate"/><ComboBoxItem Content="Analyze model"/><ComboBoxItem Content="Model Assist"/></ComboBox><CheckBox x:Name="ZoomPreview" Content="Fit the viewport to a generated preview" Margin="0,20,0,8"/><CheckBox x:Name="CompactMode" Content="Compact conversation spacing"/><Button Content="Save preferences" Click="SavePreferencesClick" Background="{StaticResource Primary}" BorderThickness="0" Margin="0,16,0,0"/><TextBlock x:Name="PreferencesStatus" Foreground="#BCA4F1" Margin="0,12" TextWrapping="Wrap"/></StackPanel>
     <StackPanel x:Name="ConnectionSettings" Visibility="Collapsed"><TextBlock Text="Connection overview" FontSize="16"/><Border Background="{StaticResource Card}" CornerRadius="10" Padding="15" Margin="0,16,0,0"><StackPanel><TextBlock Text="YOUR AI SERVICE" Foreground="#BBA4EF" FontSize="10"/><TextBlock x:Name="DashboardApiStatus" Text="Offline tools · no API connected" TextWrapping="Wrap" Margin="0,9"/><Button Content="Manage API profiles →" Click="SettingsClick"/></StackPanel></Border><Border Background="{StaticResource Card}" CornerRadius="10" Padding="15" Margin="0,12,0,0"><StackPanel><TextBlock Text="LOCAL MCP" Foreground="#BBA4EF" FontSize="10"/><TextBlock x:Name="DashboardMcpStatus" Text="Stopped" TextWrapping="Wrap" Margin="0,9"/><Button Content="Manage MCP connection →" Click="McpClick"/></StackPanel></Border><TextBlock Text="API and MCP are independent. The API plans from this panel; MCP lets another client propose plans. Both use validated previews and explicit Apply." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="0,18,0,0"/></StackPanel>
     <StackPanel x:Name="AboutSettings" Visibility="Collapsed"><Ellipse Width="126" Height="126" HorizontalAlignment="Left" Margin="0,0,0,20"><Ellipse.Fill><ImageBrush x:Name="AboutLogoBrush" Viewbox="0.082,0.092,0.834,0.828" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><TextBlock Text="AI Archi-Tec Studio" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersion" Foreground="#BCA4F1" Margin="0,7,0,20"/><TextBlock Text="Loaded plugin file" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AboutInstallPath" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,18"/><TextBlock Text="Concept, design and product ownership" Foreground="{StaticResource Muted}"/><TextBlock Text="Hasan Sharif Askari" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,18"/><TextBlock Text="An architectural assistant built around the Rhino workflow: describe an idea, validate a structured plan, review a viewport preview and Apply editable native geometry. Generate, Analyze and Model Assist have independent session workspaces." TextWrapping="Wrap" LineHeight="20"/><TextBlock Text="Built with C#, .NET 8, RhinoCommon, Eto and WPF. API keys belong to each user; MCP connects compatible desktop clients. This beta supports concept modeling, not construction documentation or unrestricted image reconstruction." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="0,15,0,17"/><Button Content="Project website ↗" Click="WebsiteClick"/><Button Content="GitHub · source and installation ↗" Click="GithubClick" Margin="0,9,0,0"/></StackPanel>
    </StackPanel></ScrollViewer>
   </Grid>
  </Border>
 </Grid>
</UserControl>
