<UserControl x:Class="ArchiTec.RhinoPlugin.Views.StudioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B0D18" Foreground="#F2F1FA" FontFamily="Segoe UI" FontSize="12" MinWidth="330">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9399B5"/>
  <SolidColorBrush x:Key="Card" Color="#141729"/>
  <LinearGradientBrush x:Key="Primary" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#934AF5" Offset="0"/><GradientStop Color="#4D6CF1" Offset="1"/></LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E8E9F6"/><Setter Property="Background" Value="#1A1E33"/><Setter Property="BorderBrush" Value="#30344C"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#A38CF4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,5"/><Setter Property="FontSize" Value="17"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101424"/><Setter Property="Foreground" Value="#E9EAF8"/><Setter Property="CaretBrush" Value="#C7B1FF"/><Setter Property="BorderBrush" Value="#353A56"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="SelectionBrush" Value="#6E50BE"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#101424"/><Setter Property="Foreground" Value="#E9EAF8"/><Setter Property="CaretBrush" Value="#C7B1FF"/><Setter Property="BorderBrush" Value="#353A56"/><Setter Property="Padding" Value="11,9"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECEBF5"/><Setter Property="Background" Value="#1C2035"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#353A56"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#1B2036"/><Setter Property="Foreground" Value="#ECEBF5"/><Setter Property="Padding" Value="10,7"/></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#1A1E33" BorderBrush="#343952" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" Foreground="#ADB1CB" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,7,28,7" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1A1E33" BorderBrush="#4B426C" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="330"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B7BCD3"/><Setter Property="Margin" Value="0,8"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101222" BorderBrush="#22253B" BorderThickness="0,0,1,0">
   <DockPanel Margin="8,15">
    <StackPanel DockPanel.Dock="Top"><Image x:Name="RailLogo" Width="36" Height="36" Margin="0,0,0,25"/><Button x:Name="GenerateNav" Style="{StaticResource Nav}" Content="&#xE8F2;" ToolTip="Generate architecture" Click="GenerateMode" Background="#38265D"/><Button x:Name="AnalyzeNav" Style="{StaticResource Nav}" Content="&#xE9D9;" ToolTip="Analyze model" Click="AnalyzeMode"/><Button x:Name="AssistNav" Style="{StaticResource Nav}" Content="&#xE8A5;" ToolTip="Model Assist" Click="AssistMode"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Button Style="{StaticResource Nav}" Content="&#xE774;" ToolTip="MCP connection" Click="McpClick"/><Button Style="{StaticResource Nav}" Content="&#xE713;" ToolTip="API settings" Click="SettingsClick"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="18,18,18,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="21" FontWeight="SemiBold"><Run Text="AI "/><Run Text="Archi-Tec" Foreground="#B69BF8"/></TextBlock><TextBlock Text="ARCHITECTURE, IN YOUR WORKFLOW" FontSize="8" Foreground="{StaticResource Muted}" Margin="1,5,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource Quiet}" Click="SettingsClick" ToolTip="Connection settings"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="17"/></Button></Grid>
   <StackPanel Grid.Row="1" Margin="0,18,0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ConnectionLabel" Foreground="#D0B378" Text="●  Add your AI service" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="McpChip" Click="McpClick" Padding="8,4" FontSize="10" Content="MCP  ↗"/></Grid><ComboBox x:Name="ModelSelector" Visibility="Collapsed" Margin="0,10,0,0" SelectionChanged="ModelChanged" ToolTip="Exact model used for this conversation"/><TextBlock x:Name="ContextLabel" Text="Reading Rhino context…" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
   <Grid Grid.Row="2">
    <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
     <StackPanel x:Name="Conversation">
      <StackPanel x:Name="Welcome" Margin="0,16,0,18">
       <Border Width="46" Height="46" CornerRadius="13" Background="#211A3A" HorizontalAlignment="Left" Margin="0,0,0,18"><TextBlock Text="✧" Foreground="#C1A4FF" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <TextBlock x:Name="HeroTitle" Text="Your idea.&#10;A model you can shape." FontSize="26" FontWeight="SemiBold" LineHeight="33" TextWrapping="Wrap"/>
       <TextBlock Text="Describe a space, attach a reference, or refine what’s already in your Rhino document." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20" Margin="0,12,0,22"/>
       <Button HorizontalContentAlignment="Left" Padding="14,12" Click="BuildingExample"><StackPanel><TextBlock Text="◇  Start with a building" FontWeight="SemiBold"/><TextBlock Text="Five floors, editable slabs and façades" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Button>
       <Button HorizontalContentAlignment="Left" Padding="14,12" Margin="0,8,0,0" Click="BoxExample"><StackPanel><TextBlock Text="↗  Try the modeling workflow" FontWeight="SemiBold"/><TextBlock Text="Create a box, then move the same object" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Button>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#D90B0D18" CornerRadius="10" VerticalAlignment="Bottom" Margin="0,8,0,4" Padding="13"><StackPanel><Grid><TextBlock Text="Planning your model…" Foreground="#C4AFFA" VerticalAlignment="Center"/><Button Content="Cancel" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Click="CancelClick" Padding="5"/></Grid><ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Foreground="#9568F5" Background="#24263C"/></StackPanel></Border>
   </Grid>
   <Border x:Name="PreviewCard" Grid.Row="3" Visibility="Collapsed" Background="#171A30" BorderBrush="#51406F" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,12">
    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="✧  READY TO BUILD" FontSize="9" FontWeight="SemiBold" Foreground="#BBA0F3"/><TextBlock x:Name="ActionCount" Grid.Column="1" FontSize="9" Foreground="{StaticResource Muted}"/></Grid><TextBlock x:Name="PlanSummary" TextWrapping="Wrap" Margin="0,10,0,6" LineHeight="19" MaxHeight="78"/><TextBlock x:Name="PlanUnits" FontSize="10" Foreground="{StaticResource Muted}"/><Expander Header="View operations" Foreground="#A4ACC9" FontSize="10" Margin="0,9,0,0"><ScrollViewer MaxHeight="90"><TextBlock x:Name="PlanDetails" TextWrapping="Wrap" Margin="0,7"/></ScrollViewer></Expander><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Apply to this document  →" Background="{StaticResource Primary}" BorderThickness="0" Click="ApplyClick"/><Button Grid.Column="1" Content="Cancel" Style="{StaticResource Quiet}" Margin="6,0,0,0" Click="CancelClick"/></Grid></StackPanel>
   </Border>
   <Border Grid.Row="4" Background="#131628" BorderBrush="#3F385B" BorderThickness="1" CornerRadius="12" Padding="12">
    <StackPanel><Grid><TextBox x:Name="PromptInput" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" TextChanged="PromptChanged" PreviewKeyDown="PromptKey"/><TextBlock x:Name="PromptPlaceholder" Text="Describe your architectural idea…" Foreground="#737D9F" Margin="1,2" IsHitTestVisible="False"/></Grid><TextBlock x:Name="AttachmentLabel" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#B4A2E2" Margin="0,5"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource Quiet}" Click="AttachClick" ToolTip="Attach or remove a reference image"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE723;" FontSize="16"/></Button><TextBlock Grid.Column="1" x:Name="ModeLabel" Text="GENERATE" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0"/><Button Grid.Column="2" x:Name="SendButton" Content="Generate  ↗" Padding="15,8" Background="{StaticResource Primary}" BorderThickness="0" Click="SendClick"/></Grid></StackPanel>
   </Border>
   <Grid Grid.Row="5" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="Ready · offline examples available" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Style="{StaticResource Quiet}" Padding="0" FontSize="9" Content="Import plan" Click="ImportClick"/></Grid>
  </Grid>
  <Border x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#F70B0D18" Padding="22">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Connections" FontSize="23" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Style="{StaticResource Quiet}" Content="✕" Click="CloseSettings"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Your API" Click="ApiTab"/><Button Grid.Column="1" Content="Local MCP" Margin="8,0,0,0" Click="McpTab"/></Grid>
     <StackPanel x:Name="ApiSettings" Margin="0,22,0,0">
      <TextBlock Text="Use the intelligence you choose." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Your provider. Your model. Your own API key." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>
      <TextBlock Text="AI service" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="SourceSelector" SelectionChanged="SourceChanged"><ComboBoxItem Content="OpenRouter"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="OpenAI-compatible / local"/></ComboBox>
      <TextBlock Text="API base URL" Foreground="{StaticResource Muted}" Margin="0,18,0,7"/><TextBox x:Name="ApiUrl"/>
      <TextBlock Text="Personal API key" Foreground="{StaticResource Muted}" Margin="0,18,0,7"/><PasswordBox x:Name="ApiKey"/>
      <CheckBox x:Name="RememberKey" Content="Remember securely on this Windows account"/>
      <TextBlock Text="Optional storage uses Windows encryption. Your key is sent only to the API address you configure." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" LineHeight="17" Margin="0,0,0,18"/>
      <Button x:Name="ConnectButton" Content="Connect and load models  →" Background="{StaticResource Primary}" BorderThickness="0" Click="ConnectClick"/>
      <TextBlock x:Name="ApiStatus" TextWrapping="Wrap" Margin="0,13" Foreground="#C1ADF0"/>
      <Button Content="Use offline examples" Background="Transparent" Click="OfflineClick"/>
      <Border Background="{StaticResource Card}" CornerRadius="9" Padding="12" Margin="0,20,0,0"><TextBlock Text="OpenRouter can route to compatible Gemini, Claude and other model providers. Compatible API sources must support structured JSON outputs. A ChatGPT/Codex subscription by itself is not an API credential." TextWrapping="Wrap" FontSize="10" LineHeight="18" Foreground="{StaticResource Muted}"/></Border>
     </StackPanel>
     <StackPanel x:Name="McpSettings" Visibility="Collapsed" Margin="0,22,0,0">
      <TextBlock Text="Bring your AI client into Rhino." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="A local connection for desktop MCP clients. No plugin API key is needed in this mode." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>
      <Button x:Name="McpStartButton" Content="Start localhost MCP  →" Background="{StaticResource Primary}" BorderThickness="0" Click="McpStartClick"/>
      <TextBlock x:Name="McpStatus" Text="Not connected" Foreground="#BCA4F1" TextWrapping="Wrap" Margin="0,16"/>
      <TextBox x:Name="McpUrl" IsReadOnly="True" Text="http://127.0.0.1:5188/mcp"/>
      <TextBlock Text="Local access token" Foreground="{StaticResource Muted}" Margin="0,16,0,7"/><PasswordBox x:Name="McpToken" IsEnabled="False"/>
      <Button Content="Copy desktop client setup" Click="CopyMcpClick" Margin="0,17,0,8"/><Button Content="Open ChatGPT  ↗" Click="OpenChatClick" Background="Transparent"/>
      <Border Background="{StaticResource Card}" CornerRadius="9" Padding="12" Margin="0,20,0,0"><TextBlock Text="Cloud chat cannot reach your Windows localhost directly. Use a desktop MCP client or local connector with the copied setup. Open ChatGPT opens the website; it does not install a connector or send a command. Modeling requests appear here as previews and await Apply." TextWrapping="Wrap" FontSize="10" LineHeight="18" Foreground="{StaticResource Muted}"/></Border>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Grid>
  </Border>
 </Grid>
</UserControl>
